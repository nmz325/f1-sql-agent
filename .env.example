# Copy to .env and fill in the values. On Streamlit Community Cloud, put the
# same keys in the app's Secrets instead (TOML: KEY = "value").
GROQ_API_KEY=

# LLM used by the agent, as "provider:model" (LangChain init_chat_model format).
# See the models your key can use with: uv run python scripts/check_groq.py
F1_AGENT_MODEL=groq:openai/gpt-oss-120b

# Web app only. Model used when the main one runs out of quota (Groq counts
# quotas per model), and new questions each visitor may send per visit
# (leave empty for no limit, as when you run the app yourself).
F1_FALLBACK_MODEL=groq:openai/gpt-oss-20b
F1_QUESTION_LIMIT=
